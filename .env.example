BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@scopegate.local"
ADMIN_PASSWORD=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
CRON_SECRET=""
OBSERVABILITY_URL="https://signoz.chatindex.app"
