generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  emailVerified Boolean        @default(false)
  name          String?
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  teamMembers   TeamMember[]
  notifications Notification[]

  // Billing (cloud only). Polar is the system of record; these columns are a
  // local cache written by the customer.state_changed webhook, so the MCP hot
  // path can resolve a plan without a network call. Ignored entirely when
  // SCOPEGATE_CLOUD is unset.
  polarCustomerId String?   @unique
  planSlug        String    @default("free")
  planStatus      String?
  planValidUntil  DateTime?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Project {
  id                 String              @id @default(cuid())
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  teamMembers        TeamMember[]
  serviceConnections ServiceConnection[]
  mcpEndpoints       McpEndpoint[]
  auditLogs          AuditLog[]
  oauthApps          ProviderCredential[]
}

enum ProjectRole {
  member
  owner
}

model TeamMember {
  id        String      @id @default(cuid())
  role      ProjectRole @default(member)
  userId    String
  projectId String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, projectId])
}

enum ServiceProvider {
  gmail
  calendar
  drive
  googleAds
  searchConsole
  youtube
  openRouter
  linkedin
  twitter
  twitterAds
  slack
  notion
  hubspot
  github
  jira
  salesforce
  metaAds
  telegram
  semrush
  ahrefs
  stripe
  airtable
  calendly
  threads
  instagram
  googleTagManager
  email
}

enum ServiceConnectionStatus {
  active
  error
  revoked
}

model ServiceConnection {
  id                  String                  @id @default(cuid())
  provider            ServiceProvider
  accountEmail        String
  accessToken         String
  refreshToken        String?
  expiresAt           DateTime?
  metadata            Json?
  status              ServiceConnectionStatus @default(active)
  lastError           String?
  consecutiveFailures Int           @default(0)
  projectId           String
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  mcpEndpoints        McpEndpoint[]

  @@unique([projectId, provider, accountEmail])
  @@index([expiresAt])
  @@index([provider, expiresAt])
}

model McpEndpoint {
  id                  String               @id @default(cuid())
  name                String
  apiKey              String               @unique
  projectId           String
  serviceConnectionId String
  rateLimitPerMinute  Int                  @default(60)
  isActive            Boolean              @default(true)
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceConnection   ServiceConnection    @relation(fields: [serviceConnectionId], references: [id], onDelete: Cascade)
  permissions         EndpointPermission[]
  auditLogs           AuditLog[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([projectId])
}

model EndpointPermission {
  id         String      @id @default(cuid())
  action     String
  endpointId String
  endpoint   McpEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, action])
}

enum AuditStatus {
  success
  error
}

model AuditLog {
  id         String       @id @default(cuid())
  endpointId String?
  projectId  String
  endpoint   McpEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action     String
  params     Json?
  status     AuditStatus
  error      String?
  duration   Int?
  createdAt  DateTime     @default(now())

  @@index([projectId])
}

model RateLimitBucket {
  endpointId  String
  windowStart DateTime
  count       Int      @default(1)

  @@id([endpointId, windowStart])
  @@map("rate_limit_bucket")
}

// A project's own OAuth application credentials ("bring your own app").
//
// Keyed by credential GROUP, not by provider: one Google Cloud client backs
// Gmail, Calendar, Drive, Ads, Search Console, YouTube and Tag Manager, so the
// user pastes it once. The group is derived from ProviderDef.connect.startRoute
// — see getCredentialGroup() in provider-registry.ts.
model ProviderCredential {
  id           String   @id @default(cuid())
  projectId    String
  appGroup     String
  clientId     String
  clientSecret String // encrypted with crypto.ts, same treatment as tokens
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, appGroup])
  @@map("provider_credential")
}

// Monthly MCP request counter for plan quotas (cloud only). Same atomic
// INSERT … ON CONFLICT DO UPDATE shape as RateLimitBucket — one round-trip
// returning the running total, instead of aggregating over AuditLog, whose
// rows are best-effort (written inside a try/catch) and indexed by project.
model MonthlyUsage {
  userId String
  month  String // "2026-08"
  count  Int    @default(1)

  @@id([userId, month])
  @@map("monthly_usage")
}

enum NotificationType {
  error
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(error)
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model InviteToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("invite_token")
}
