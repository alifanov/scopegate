# ── Required ───────────────────────────────────────────────────────────────
# Only these matter for `pnpm dev` / a bare `pnpm build`. Running via
# `docker compose --profile local up` needs none of this file at all — DATABASE_URL
# defaults to the bundled Postgres, and BETTER_AUTH_SECRET/ADMIN_PASSWORD are
# generated on first boot (see docker-entrypoint.sh). See README "Quick start".
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scopegate?schema=public"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@scopegate.local"
ADMIN_PASSWORD=""

# ── Optional ───────────────────────────────────────────────────────────────
CRON_SECRET=""
OBSERVABILITY_URL="https://signoz.chatindex.app"
OBSERVABILITY_API_KEY=""
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_SERVICE_NAME=""

# ── OAuth providers (all optional) ────────────────────────────────────────────
# Every block below is independent — leave a provider's vars empty and it simply
# doesn't show up as connectable; nothing else breaks. This is the operator-level
# app shared by every project on this instance; a project can also register its
# own OAuth app from the UI instead (Settings → Connections → "Use your own app").
GOOGLE_CLIENT_ID=""             # Gmail, Calendar, Drive, Ads, Search Console, YouTube, Tag Manager
GOOGLE_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""   # only needed if Google Ads is used
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
JIRA_CLIENT_ID=""
JIRA_CLIENT_SECRET=""
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
META_APP_ID=""                  # Meta Ads
META_APP_SECRET=""
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""

# ── Cloud deployment only — leave unset for self-hosted ──────────────────────
# Unset: landing page and /pricing are hidden, /signup 404s, no plan limits.
# Self-host is full-featured with none of this section set — this only turns on
# the hosted SaaS shell (billing, signup) around the same app.
SCOPEGATE_CLOUD=""
# Sign-in with Google. A SEPARATE OAuth client from GOOGLE_CLIENT_ID above —
# that one carries the restricted service scopes (gmail.modify, drive) and the
# CASA verification burden. This one only needs `openid email profile`, and its
# only authorised redirect URI is <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_SIGNIN_CLIENT_ID=""
GOOGLE_SIGNIN_CLIENT_SECRET=""
# Magic-link sign-in. Both must be set or the plugin stays off.
RESEND_API_KEY=""
EMAIL_FROM="ScopeGate <noreply@notify.scopegate.dev>"
# Billing via Polar. Access token and webhook secret must BOTH be set or the
# plugin stays off (and the /billing page renders without checkout buttons).
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_SERVER="sandbox"
# Polar product ids, one per paid plan in src/lib/plans.ts.
POLAR_PRODUCT_PRO=""
POLAR_PRODUCT_TEAM=""

# ── Dark Flow mailbox routine — tooling only, the app never reads these ──────
# Used by `/darkflow:mailbox-check` (~/.darkflow/mailbox/{fetch,send}.py) to
# turn incoming mail into tasks and send approved replies. Leave empty and the
# routine skips itself with "mailbox not configured".
MAILBOX_IMAP_HOST=""
MAILBOX_IMAP_PORT="993"          # SSL
MAILBOX_IMAP_USER=""
MAILBOX_IMAP_PASSWORD=""
MAILBOX_SMTP_HOST=""
MAILBOX_SMTP_PORT="587"          # STARTTLS; use 465 together with MAILBOX_SMTP_SSL=1
MAILBOX_SMTP_USER=""
MAILBOX_SMTP_PASSWORD=""
MAILBOX_SMTP_SSL=""              # "1" → implicit SSL instead of STARTTLS
